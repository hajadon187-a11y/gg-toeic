
# APIキーを含む環境変数ファイル
.env

# AVL / COCA-Academic の語彙リスト。
# 配布元が「学術利用に限る」「他サイトへ再配布しないこと」を明示しているため、
# 取得物はリポジトリに含めない。各自で data/academic_lists.json として取得すること。
data/academic_lists.json

# 候補プールの中間生成物（再生成可能・サイズが大きい）。
data/band_replacements.json

# 言語別スライス。`extract_language_slices.py` でいつでも再生成できる。
data/slices/
