<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 11+ のPackageManager検索対象を、対応するAIアプリに限定して宣言する。 -->
    <queries>
        <package android:name="com.openai.chatgpt" />
        <package android:name="com.google.android.apps.bard" />
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- Google Play の買い切り商品（TOEIC上位レベル解放）に必要 -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".GgToeicApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_gachi"
        android:label="GG TOEIC"
        android:roundIcon="@mipmap/ic_launcher_gachi_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GGToeic">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.GGToeic.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".notification.StreakReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.gachiguild.gachitoeic.action.STREAK_REMINDER" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
